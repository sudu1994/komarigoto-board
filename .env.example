# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=        # publishable (anon) key — safe for browsers
SUPABASE_SECRET_KEY=             # secret (service_role) key — server only
# Board
ROOM_CODE=                       # e.g. a random word; goes into the QR code
ADMIN_KEY=                       # long random string; /admin?k=...
# AI grouping (optional — falls back to a vote ranking)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
